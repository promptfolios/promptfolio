# Copy to .env.local and adjust. .env.local is not committed.

# Profile JSON file to load, as a file name inside apps/portfolio/profile/.
# Defaults to example.profile.json (fictional sample data).
# Keep your real profile in a *.local.json file, which is not committed.
PROMPTFOLIO_PROFILE_FILE=profile.local.json

# Model: "provider:model". Each provider with an example, which is also its default model:
#   google       google:gemini-3.8-flash
#   anthropic    anthropic:claude-haiku-5-5
#   openrouter   openrouter:google/gemma-4-31b-it:free
#   gateway      gateway:nvidia/nemotron-3.5-lightning-free (Vercel AI Gateway)
# "provider" alone uses its default model. If unset, the first of google, anthropic, openrouter,
# gateway whose key is set is used.
PROMPTFOLIO_MODEL=google:gemini-3.8-flash

# Provider API keys. Read only on the server: never prefix them with NEXT_PUBLIC_.
# Without the selected provider's key the app still builds and renders, but replies show an error.
# Set a monthly spend limit with your provider: there is no rate limiting until M11.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional contact form. Set all six to show the Contact button, or none to have no form. Read only
# on the server: never prefix them with NEXT_PUBLIC_. Setup: docs/guides/contact-setup.md.
# Use a Resend key with "sending access" only.
RESEND_API_KEY=
# Where messages go. Private: visitors see the owner's name, never this address.
CONTACT_TO_EMAIL=
# "address" or "Name <address>". onboarding@resend.dev delivers only to your Resend account's address.
CONTACT_FROM_EMAIL=
# Signs confirmation tokens and hashes visitors' IP addresses, at least 32 characters:
# openssl rand -base64 32
CONTACT_TOKEN_SECRET=
# An Upstash Redis database, which holds the one-email-per-day limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional GitHub token for pnpm --filter portfolio refresh, which writes the GitHub data next to
# the profile (configure the username in profile/<profile>.github.json). Without a token the command
# keeps the 12 most recently pushed repositories; with one, pinned repositories come first and up to 20
# are kept. Use a fine-grained token with read access to public repositories only. The running app
# never reads it.
GITHUB_TOKEN=
