# Copy to .env.local and adjust. .env.local is not committed.

# Profile JSON file to load, as a file name inside apps/portfolio/profile/.
# Defaults to example.profile.json (fictional sample data).
# Keep your real profile in a *.local.json file, which is not committed.
PROMPTFOLIO_PROFILE_FILE=profile.local.json

# Model: "provider:model", with provider google or anthropic. "provider" alone uses its default
# model (google: gemini-3.8-flash, anthropic: claude-haiku-5-5). Switch providers by changing
# this one line. If unset, the first provider below whose key is set is used.
PROMPTFOLIO_MODEL=google:gemini-3.8-flash

# Provider API keys. Read only on the server: never prefix them with NEXT_PUBLIC_.
# Without the selected provider's key the app still builds and renders, but replies show an error.
# Set a monthly spend limit with your provider: there is no rate limiting until M11.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
