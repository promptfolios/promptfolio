# Copy to .env.local and adjust. .env.local is not committed.

# Profile JSON file to load, as a file name inside apps/portfolio/profile/.
# Defaults to example.profile.json (fictional sample data).
# Keep your real profile in a *.local.json file, which is not committed.
PROMPTFOLIO_PROFILE_FILE=profile.local.json

# Model: "provider:model", with provider google, anthropic, or openrouter. "provider" alone uses
# its default model (google: gemini-3.8-flash, anthropic: claude-haiku-5-5, openrouter:
# google/gemma-4-31b-it:free). Switch providers by changing this one line. If unset, the first of
# google, anthropic, openrouter whose key is set is used.
#
# OpenRouter model ids are "vendor/model", for example openrouter:anthropic/claude-haiku-5.5.
# The default is a free model: no credits needed, but 20 requests per minute and 50 per day
# (1,000 per day once 10 credits have been bought), and free models are added and removed often.
# Pick a replacement that supports tools: https://openrouter.ai/models?supported_parameters=tools
# Free models are served by hosts with their own logging and training policies: check your
# OpenRouter privacy settings, and prefer a paid model when your real profile is loaded.
PROMPTFOLIO_MODEL=google:gemini-3.8-flash

# Provider API keys. Read only on the server: never prefix them with NEXT_PUBLIC_.
# Without the selected provider's key the app still builds and renders, but replies show an error.
# Set a monthly spend limit with your provider: there is no rate limiting until M11.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
