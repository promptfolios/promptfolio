{
  "name": "@promptfolio/ai",
  "version": "0.0.1",
  "description": "Server-only chat handler for Promptfolio: validates requests and streams model replies.",
  "keywords": [
    "promptfolio",
    "portfolio",
    "ai",
    "ai-sdk",
    "chat"
  ],
  "homepage": "https://github.com/promptfolios/promptfolio/tree/main/packages/ai#readme",
  "bugs": "https://github.com/promptfolios/promptfolio/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptfolios/promptfolio.git",
    "directory": "packages/ai"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./evaluation": "./src/evaluation/evaluation.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./evaluation": {
        "types": "./dist/evaluation/evaluation.d.ts",
        "default": "./dist/evaluation/evaluation.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@promptfolio/core": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "ai": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ai": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
