{
  "name": "@promptfolio/source-github",
  "version": "0.0.2",
  "description": "GitHub source adapter for Promptfolio: fetches public repositories and normalizes them into profile records.",
  "keywords": [
    "promptfolio",
    "portfolio",
    "github"
  ],
  "homepage": "https://github.com/promptfolios/promptfolio/tree/main/packages/source-github#readme",
  "bugs": "https://github.com/promptfolios/promptfolio/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptfolios/promptfolio.git",
    "directory": "packages/source-github"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/fixtures"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@promptfolio/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
