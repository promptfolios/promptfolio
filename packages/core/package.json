{
  "name": "@promptfolio/core",
  "version": "0.0.1",
  "private": true,
  "description": "Canonical profile model and framework-agnostic core logic for Promptfolio.",
  "keywords": [
    "promptfolio",
    "portfolio",
    "profile",
    "provenance"
  ],
  "homepage": "https://github.com/promptfolios/promptfolio/tree/main/packages/core#readme",
  "bugs": "https://github.com/promptfolios/promptfolio/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptfolios/promptfolio.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
